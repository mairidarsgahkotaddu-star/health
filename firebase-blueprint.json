{
  "entities": {
    "DoctorCheckup": {
      "path": "users/{userId}/checkups/{checkupId}",
      "fields": {
        "doctorName": { "type": "string" },
        "specialty": { "type": "string" },
        "clinicOrHospital": { "type": "string" },
        "checkupDateMillis": { "type": "number" },
        "diagnosisReason": { "type": "string" },
        "clinicalNotes": { "type": "string" },
        "followUpDateMillis": { "type": "number", "optional": true },
        "followUpReminderSet": { "type": "boolean" },
        "vitalsSummary": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "DiagnosticTest": {
      "path": "users/{userId}/diagnostic_tests/{testId}",
      "fields": {
        "testName": { "type": "string" },
        "orderedByDoctor": { "type": "string" },
        "testDateMillis": { "type": "number" },
        "testCategory": { "type": "string" },
        "resultDisplayValue": { "type": "string" },
        "referenceRange": { "type": "string" },
        "statusFlag": { "type": "string" },
        "clinicalNotes": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "MedicationLog": {
      "path": "users/{userId}/medications/{medicationId}",
      "fields": {
