        "updatedAt": { "type": "timestamp" }
      }
    },
    "VitalMeasurement": {
      "path": "users/{userId}/vitals/{vitalId}",
      "fields": {
        "timestampMillis": { "type": "number" },
        "systolicBp": { "type": "number", "optional": true },
        "diastolicBp": { "type": "number", "optional": true },
        "heartRateBpm": { "type": "number" },
        "bloodOxygenSpO2": { "type": "number", "optional": true },
